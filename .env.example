# immich-tg configuration. Copy to .env and fill in.

# --- Immich -----------------------------------------------------------------

# Immich URL for API calls and video downloads. Typically Immich's LAN address.
IMMICH_URL=http://192.168.1.10:2283

# Public Immich URL, used for Share Links and for Immich links in Problem
# Reports. Typically your public nginx domain.
IMMICH_PUBLIC_URL=https://photos.example.com

# API key of the Source User. Required scopes: user.read, asset.read,
# asset.view, asset.share, sharedLink.create.
IMMICH_API_KEY=

# --- Telegram ---------------------------------------------------------------

# The shared, self-hosted Telegram Bot API server (--local mode), reached over
# the external telegram-bot-api Docker network.
TELEGRAM_API_URL=http://telegram-bot-api:8081

# Bot token from @BotFather. The bot must have been logged out of the cloud
# Bot API once (logOut) before the local server can use it.
TELEGRAM_BOT_TOKEN=

# Channel where Posts are published. A numeric chat ID such as -1001234567890,
# or @channelname. The bot must be an admin allowed to post messages.
TELEGRAM_VIDEO_CHANNEL_ID=

# Private channel for Problem Reports and started/stopped messages. Same format
# and admin rights as the Video Channel.
TELEGRAM_LOG_CHANNEL_ID=

# --- Optional ---------------------------------------------------------------

# How often to ask Immich for New Videos (Go duration). Default: 30s.
#POLL_INTERVAL=30s

# How long a New Video may wait for its Transcode before it gets a Link-only
# Post and a Problem Report (Go duration). Default: 2h.
#WAIT_TIMEOUT=2h

# Time zone for the Watch Start shown in the started message. Default: UTC.
#TZ=Europe/Stockholm
